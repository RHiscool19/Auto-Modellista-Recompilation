+static void time_report(void)
+{
+    uint64_t now = xbox_HostNowNs();
+    if (!s_tm_last) { s_tm_last = now; return; }
+    if (now - s_tm_last >= 5000000000ull) {
+        double wall = (double)(now - s_tm_last) / 1e6;
+        fprintf(stderr, "[XF-TIME] last %.0f ms: vertex programs %.0f ms (%.0f%%),"
+                " program batches %.0f ms (%.0f%%), back end %.0f ms (%.0f%%)\n",
+                wall, s_tm_xf / 1e6, 100.0 * s_tm_xf / 1e6 / wall,
+                s_tm_batch / 1e6, 100.0 * s_tm_batch / 1e6 / wall,
+                s_tm_backend / 1e6, 100.0 * s_tm_backend / 1e6 / wall);
+#if defined(_WIN32)
+        thread_cpu_report(wall);
+#endif
+        s_tm_xf = s_tm_batch = s_tm_backend = 0;
+        s_tm_last = now;
+    }
+}
