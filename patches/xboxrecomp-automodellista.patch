+        {
+            static int idle_us = -1, idle_passes;
+            static uint32_t prev_put;
+            static HANDLE timer;
+            uint32_t put_now = *(volatile uint32_t *)((char *)regs + NV2A_USER_DMA_PUT);
+            if (idle_us < 0) {
+                const char *e = getenv("RECOMP_GPU_IDLE_US");
+                idle_us = e ? atoi(e) : 0;
+                if (idle_us > 0) {
+                    timer = CreateWaitableTimerExW(NULL, NULL,
+                                0x00000002 /* CREATE_WAITABLE_TIMER_HIGH_RESOLUTION */,
+                                TIMER_ALL_ACCESS);
+                    if (!timer) timer = CreateWaitableTimerW(NULL, TRUE, NULL);
+                    fprintf(stderr, "[NV2A] GPU thread idles %d us between empty passes\n", idle_us);
+                }
+            }
+            if (put_now != prev_put) { prev_put = put_now; idle_passes = 0; }
+            else idle_passes++;
+            if (idle_us > 0 && timer && idle_passes > 32) {
+                LARGE_INTEGER due;
+                due.QuadPart = -(LONGLONG)idle_us * 10;   /* relative, 100 ns units */
+                if (SetWaitableTimer(timer, &due, 0, NULL, NULL, FALSE))
+                    WaitForSingleObject(timer, 5);
+                else
+                    Sleep(0);
+            } else {
+                Sleep(0);  /* yield; the waiter is spinning on another core */
+            }
+        }
     }
     return 0;
 }
