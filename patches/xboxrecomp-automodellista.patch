+/* Where the executor's time goes, every 5 s: vertex programs (the
+ * transform loop), the whole program batch, and the back end's draw. A
+ * cost meter for moving vertex work to the GPU. */
+static uint64_t s_tm_xf, s_tm_batch, s_tm_backend, s_tm_last;
+
+#if defined(_WIN32)
+#include <tlhelp32.h>
+/* Per-thread CPU over the same 5 s: which thread is the one at 100%. The
+ * frame rate halves (60 -> 30) as soon as one frame misses a vblank, so the
+ * question is which thread's frame is too long -- the game's, the executor's
+ * (marked "<- GPU executor") or the APU's. */
+static void thread_cpu_report(double wall_ms)
+{
+    enum { MAXT = 128 };
+    static DWORD tid[MAXT];
+    static ULONGLONG last[MAXT];
+    static int nt;
+    DWORD me = GetCurrentProcessId(), self = GetCurrentThreadId();
+    HANDLE snap = CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0);
+    THREADENTRY32 te;
+    struct { DWORD id; double pct; } top[6] = {{0}};
+    int k;
+
+    if (snap == INVALID_HANDLE_VALUE) return;
+    te.dwSize = sizeof te;
+    if (Thread32First(snap, &te)) do {
+        HANDLE h;
+        FILETIME c, e, kt, ut;
+        ULONGLONG t, prev = 0;
+        int i, found = -1;
+        if (te.th32OwnerProcessID != me) continue;
+        h = OpenThread(THREAD_QUERY_LIMITED_INFORMATION, FALSE, te.th32ThreadID);
+        if (!h) continue;
+        if (GetThreadTimes(h, &c, &e, &kt, &ut)) {
+            t = ((ULONGLONG)kt.dwHighDateTime << 32 | kt.dwLowDateTime)
+              + ((ULONGLONG)ut.dwHighDateTime << 32 | ut.dwLowDateTime);
+            for (i = 0; i < nt; i++) if (tid[i] == te.th32ThreadID) { found = i; break; }
+            if (found < 0 && nt < MAXT) { found = nt++; tid[found] = te.th32ThreadID; last[found] = t; }
+            if (found >= 0) {
+                double pct;
+                prev = last[found]; last[found] = t;
+                pct = (double)(t - prev) / 1e4 / wall_ms * 100.0;   /* 100 ns units */
+                for (k = 0; k < 6; k++)
+                    if (pct > top[k].pct) {
+                        int m;
+                        for (m = 5; m > k; m--) top[m] = top[m - 1];
+                        top[k].id = te.th32ThreadID; top[k].pct = pct;
+                        break;
+                    }
+            }
+        }
+        CloseHandle(h);
+    } while (Thread32Next(snap, &te));
+    CloseHandle(snap);
+    fprintf(stderr, "[THREAD-CPU]");
+    for (k = 0; k < 6 && top[k].id; k++)
+        fprintf(stderr, " tid %lu %.0f%%%s;", (unsigned long)top[k].id, top[k].pct,
+                top[k].id == self ? " <- GPU executor" : "");
+    fprintf(stderr, "\n");
+}
+#endif
